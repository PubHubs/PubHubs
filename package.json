{
	"name": "pubhubs-canonical",
	"private": true,
	"type": "module",
	"description": "PubHubs monorepo",
	"workspaces": [
		"global-client",
		"hub-client"
	],
	"scripts": {
		"prepare": "husky",
		"dev:global": "npm run dev --workspace=global-client",
		"dev:hub": "npm run dev --workspace=hub-client",
		"build:global": "npm run build --workspace=global-client",
		"build:global:native": "PUBHUBS_BASE=/ npm run build --workspace=global-client",
		"build:hub": "npm run build --workspace=hub-client",
		"lint": "prettier --config .prettierrc --write --ignore-unknown \"global-client/src/**/*.{ts,vue,js}\" \"hub-client/src/**/*.{ts,vue,js}\" && eslint --fix global-client/src hub-client/src",
		"check": "npm run check:format && npm run check:lint && npm run check:types",
		"check:audit": "node scripts/npm-audit.mjs",
		"check:format": "prettier --config .prettierrc --check --ignore-unknown \"global-client/src/**/*.{ts,vue,js}\" \"hub-client/src/**/*.{ts,vue,js}\"",
		"check:lint": "eslint --max-warnings 0 global-client/src hub-client/src",
		"check:types": "npm run type-check --workspace=hub-client && npm run type-check --workspace=global-client",
		"sync:networkhost-ip": "node scripts/sync-networkhost-ip.js",
		"patch:ios-networkhost-ip": "node scripts/patch-ios-client-config-ip.js",
		"cap:sync:ios": "npm run sync:networkhost-ip && npm run build:global:native && npm run patch:ios-networkhost-ip && npx cap sync ios",
		"cap:sync:android": "npm run sync:networkhost-ip && npm run build:global:native && npx cap sync android",
		"cap:open:android": "npm run sync:networkhost-ip && npx cap open android",
		"cap:run:android": "npm run sync:networkhost-ip && npm run build:global:native && npx cap run android",
		"cap:open:ios": "npm run sync:networkhost-ip && npx cap open ios",
		"cap:run:ios": "npm run sync:networkhost-ip && npm run build:global:native && npm run patch:ios-networkhost-ip && npx cap run ios",
		"generate:icons": "npx --yes @capacitor/assets@3 generate --ios --android --iconBackgroundColor '#001242'"
	},
	"lint-staged": {
		"global-client/src/**/*.{ts,vue,js}": [
			"prettier --config .prettierrc --write --ignore-unknown",
			"eslint --fix"
		],
		"hub-client/src/**/*.{ts,vue,js}": [
			"prettier --config .prettierrc --write --ignore-unknown",
			"eslint --fix"
		]
	},
	"devDependencies": {
		"@capacitor/cli": "^8.4.2",
		"@capacitor/core": "^8.4.2",
		"@capacitor/android": "^8.5.0",
		"@capacitor/ios": "^8.5.0",
		"@capacitor/filesystem": "^8.1.2",
		"@capacitor/share": "^8.0.1",
		"@capacitor/status-bar": "^8.0.3",
		"@eslint-community/eslint-plugin-eslint-comments": "^4",
		"@eslint/js": "^9",
		"@trivago/prettier-plugin-sort-imports": "^6.0.0",
		"eslint": "^9",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^9",
		"husky": "^9.1.7",
		"jsdom": "^29",
		"lint-staged": "^16",
		"prettier": "^3.5.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"smol-toml": "^1.7.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8"
	},
	"overrides": {
		"xcode": {
			"uuid": "^11.1.1"
		}
	},
	"allowScripts": {
		"sharp@0.32.6": true
	}
}
