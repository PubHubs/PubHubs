<?xml version="1.0" encoding="utf-8"?>
<!--
    gplay-flavor-only manifest additions, merged only into the Play Store / general APK build.
    Nothing Firebase-related may appear in src/main or src/fdroid - see the push notifications
    plan and app/build.gradle's flavor comments for why.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".push.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default small icon/colour FCM uses for any notification-payload message it might
             ever auto-render. We never send one (see FcmService: data-only, no `notification`
             block - see the push notifications plan), so this is defensive/unused in practice,
             but Firebase Messaging expects it to be present. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
    </application>
</manifest>
